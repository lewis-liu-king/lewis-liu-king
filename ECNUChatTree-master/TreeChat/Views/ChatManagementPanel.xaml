<UserControl x:Class="TreeChat.Views.ChatManagementPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TreeChat.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="0,10,0,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5,0,5,5">
            <Button Content="新聊天" Command="{Binding CreateNewChat}" Width="80"/>
            <Button Content="删除" Command="{Binding DeleteChatCommand}" Width="50" Margin="5,0,0,0"/>
            <Button Content="设置" Command="{Binding OpenSettingsCommand}" Width="50" Margin="5,0,0,0"/>
        </StackPanel>

        <ListBox Grid.Row="1"
             ItemsSource="{Binding ChatList}"
             FontSize="14"
             SelectedItem="{Binding SelectedChat, Mode=TwoWay}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="5,2" Height="30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding TreeTitle}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Width="30" Height="30" Content="⋯" FontSize="16" Background="Transparent" BorderThickness="0">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="编辑名称" Command="{Binding DataContext.EditChatTitleCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"/>
                                    <MenuItem Header="删除" Command="{Binding DataContext.DeleteChatCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>

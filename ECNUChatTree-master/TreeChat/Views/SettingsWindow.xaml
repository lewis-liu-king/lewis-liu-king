<Window x:Class="TreeChat.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="API 设置" Height="400" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 配置档案选择 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="配置档案:" VerticalAlignment="Center" Width="70"/>
            <ComboBox ItemsSource="{Binding ProfileNames}" SelectedItem="{Binding SelectedProfileName}"
                      Width="150" Margin="5,0"/>
            <Button Content="添加" Command="{Binding AddProfileCommand}" Width="50" Margin="5,0"/>
            <Button Content="删除" Command="{Binding DeleteProfileCommand}" Width="50" Margin="5,0"/>
        </StackPanel>

        <!-- 配置编辑区域 -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,5">
                <TextBlock Text="API Key:"/>
                <TextBox Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,5">
                <TextBlock Text="API 端点:"/>
                <TextBox Text="{Binding ApiEndpoint, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,5">
                <TextBlock Text="模型名称:"/>
                <TextBox Text="{Binding ModelName, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Margin="0,10,0,5">
                <TextBlock Text="Temperature (随机性):"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <Slider Value="{Binding Temperature}" Minimum="0" Maximum="2" TickFrequency="0.1"
                            IsSnapToTickEnabled="True" Grid.Column="0"/>
                    <TextBlock Text="{Binding Temperature, StringFormat={}{0:F1}}"
                               Grid.Column="1" HorizontalAlignment="Center"/>
                </Grid>
            </StackPanel>

            <StackPanel Grid.Row="4" Margin="0,5">
                <TextBlock Text="Top P (核采样):"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <Slider Value="{Binding TopP}" Minimum="0" Maximum="1" TickFrequency="0.1"
                            IsSnapToTickEnabled="True" Grid.Column="0"/>
                    <TextBlock Text="{Binding TopP, StringFormat={}{0:F1}}"
                               Grid.Column="1" HorizontalAlignment="Center"/>
                </Grid>
            </StackPanel>

            <StackPanel Grid.Row="5" Margin="0,5">
                <TextBlock Text="Top K (候选词数):"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <Slider Value="{Binding TopK}" Minimum="1" Maximum="100" TickFrequency="1"
                            IsSnapToTickEnabled="True" Grid.Column="0"/>
                    <TextBlock Text="{Binding TopK}" Grid.Column="1" HorizontalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- 按钮区域 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="取消" Width="70" Click="CancelButton_Click" Margin="0,0,10,0"/>
            <Button Content="保存" Width="70" Command="{Binding SaveCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
        </StackPanel>
    </Grid>
</Window>
